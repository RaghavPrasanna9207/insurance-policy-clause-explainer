+# --- a refusal under the wrong exclusion, when a lookup found the right one ---
+
+SPORTS_TEXT = (
+    "4.3 Hazardous Activities Expenses related to any treatment necessitated due to "
+    "participation in hazardous or adventure sports shall not be admissible under this policy."
+)
+
+
+def test_a_refusal_under_another_exclusion_is_asked_about_the_looked_up_one():
+    """`breach-of-law`: the stored answer to "injured while being arrested for
+    shoplifting" was not_covered citing 4.3, hazardous sports. Right verdict,
+    wrong clause, and the M36 rule only asks an answer that pays."""
+    from app.pipeline.scenario import compute, find_contradictions
+
+    clauses = _policy(HOSPITAL_TEXT) + _exclusions(SPORTS_TEXT, BREACH_TEXT, INTOXICATION_TEXT)
+    question = "I was injured while being arrested for shoplifting and needed hospital treatment."
+    computed = compute({}, clauses, question)
+    assert computed.exclusions == {"4.2", "4.3", "4.4"}
+    problems, irrelevant = find_contradictions(
+        [_citation("4.3", "denies")], "not_covered", computed, question)
+    assert len(problems) == 1 and irrelevant == []
+    # Both outcomes are spelled out, the one that keeps the answer first, and the
+    # line says what the previous answer was: the re-ask does not carry it.
+    assert "refused this claim without citing clause 4.4" in problems[0]
+    assert "clause 4.4 does not apply and is not cited" in problems[0]
+    assert "clause 4.4 is the clause that refuses this claim" in problems[0]
+    assert problems[0].index("does not apply") < problems[0].index("is the clause that refuses")
+    assert "You answered" not in problems[0]
+    # Already cited: nothing to ask.
+    assert find_contradictions(
+        [_citation("4.4", "denies")], "not_covered", computed, question) == ([], [])
+
+    # The alcohol lookup gets the same question.
+    drunk = "I fell down the stairs after drinking heavily and fractured my hip."
+    problems, _ = find_contradictions(
+        [_citation("4.3", "denies")], "not_covered", compute({}, clauses, drunk), drunk)
+    assert len(problems) == 1 and "without citing clause 4.2" in problems[0]
+
+
+def test_a_refusal_that_rests_on_anything_but_another_exclusion_is_not_asked():
+    """Measured, 2 samples of 2 each: asked anyway, typhoid three weeks in gave
+    up the 30-day waiting period, and Ayurvedic treatment at an unaccredited
+    clinic gave up the AYUSH clause, both for "convicted of trespassing some
+    years ago". Which exclusion applies is a question this model answers;
+    whether an old conviction outranks a waiting period is not."""
+    from app.pipeline.scenario import ShortlistClause, compute, find_contradictions
+
+    listed = ShortlistClause(
+        "Excl02", "t:9", "Excl02", "exclusion",
+        "Excl02 Specified disease waiting period: expenses shall be excluded until the "
+        "expiry of 24 months.", 1.0, waiting_periods_days=[720])
+    clauses = (_clauses() + _policy(HOSPITAL_TEXT) + _exclusions(SPORTS_TEXT, BREACH_TEXT)
+               + [listed])
+    question = "I was convicted of trespassing some years ago and have now been admitted."
+    computed = compute(
+        {"time_since_policy_start_value": 3, "time_since_policy_start_unit": "weeks"},
+        clauses, question)
+    assert list(computed.breach_of_law) == ["4.4"]
+
+    def asked(*ids):
+        problems, _ = find_contradictions(
+            [_citation(i, "denies") for i in ids], "not_covered", computed, question)
+        return [p for p in problems if "without citing clause 4.4" in p and "looked up" in p]
+
+    assert asked("4.3")                 # another exclusion alone: asked
+    assert not asked("3.2")             # a waiting period
+    assert not asked("1.1")             # a cover's own condition
+    assert not asked("4.3", "1.1")      # mixed: something other than an exclusion is in play
+    assert not asked("Excl02")          # typed exclusion, but it is a waiting period
+    # Only a refusal: the paying verdicts have their own rule.
+    problems, _ = find_contradictions(
+        [_citation("4.3", "reduces")], "conditional", computed, question)
+    assert not any("without citing clause 4.4" in p for p in problems)
