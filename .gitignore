# Python
__pycache__/
*.py[cod]
api/.venv/
.pytest_cache/

# Data: uploaded PDFs, SQLite databases, LLM cache
api/data/
data/

# Real insurer policy wordings are never committed (licensing).
# The synthetic test PDFs are generated build artefacts, reproducible from
# build_synthetic_policy.py; tests/conftest.py rebuilds them if absent. The
# labels JSON IS committed: it is small, diffable, and readable as documentation
# of what the golden set contains.
samples/*.pdf
*.pdf

# Node
web/node_modules/
web/dist/

# Env
.env

# Screenshot output from `npm run shots`
web/.screenshots/

# Per-eval reports are intermediate. evals/REPORT.md is the committed record.
evals/classification-report.md
evals/scenario-report.md

# Per-machine eval run history: which verdicts each local run produced, used
# for the comparison and stability sections. Regenerated by running the eval;
# it would change on every run, and a fresh clone starts it empty.
evals/run-history.json
